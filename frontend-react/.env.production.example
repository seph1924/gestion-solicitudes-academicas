# Plantilla para producción. En Vercel estas variables se cargan en
# Project Settings > Environment Variables (no se sube un .env real).
# Recordar: todo lo que empieza con VITE_ queda visible en el bundle.

# URL pública de la API (HTTPS). Sin barra final.
VITE_API_URL=https://URL-DE-LA-API/api

# En producción solo se muestran advertencias y errores.
VITE_LOG_LEVEL=warn

VITE_MONITOREO_URL=
