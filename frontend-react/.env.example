# Copiar este archivo como .env (o .env.local) y ajustar los valores.
# Las variables de Vite deben empezar con VITE_ para estar disponibles en el navegador.
# No colocar aquí secretos: todo lo que empieza con VITE_ queda visible en el bundle.

# URL base de la API REST (backend Node.js/Express)
VITE_API_URL=http://localhost:3000/api
