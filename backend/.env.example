# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube a GitHub.

# Puerto donde escucha la API
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# Orígenes permitidos por CORS
CORS_ORIGIN=http://localhost:4200,http://localhost:5173

# Conexión con MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/gestion_solicitudes

# Configuración de autenticación JWT
JWT_SECRET=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_SEGURA
JWT_EXPIRES_IN=1h